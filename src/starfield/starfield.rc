DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 270, 140
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Starfield Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Number of stars",IDC_STATIC,7,16,62,8
    CONTROL         "",NUMSTARS,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,73,12,150,15
    RTEXT           "#",NUMSTARSTEXT,227,16,36,8
    LTEXT           "Speed",IDC_STATIC,7,42,62,8
    CONTROL         "",SPEED,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,73,38,150,15
    RTEXT           "#",SPEEDTEXT,227,42,36,8
    LTEXT           "Star size",IDC_STATIC,7,68,62,8
    CONTROL         "",STARSIZE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,73,64,150,15
    RTEXT           "#",STARSIZETEXT,227,68,36,8
    CONTROL         "Limit frame rate",FRAMERATELIMITCHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,92,70,10
    EDITTEXT        FRAMERATELIMITEDIT,85,90,32,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",FRAMERATELIMITSPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,117,90,11,14
    LTEXT           "FPS",IDC_STATIC,133,92,20,8
    PUSHBUTTON      "About",ABOUT,7,117,52,16
    PUSHBUTTON      "Reset to defaults",DEFAULTS,75,117,76,16
    PUSHBUTTON      "Cancel",IDCANCEL,159,117,50,16
    DEFPUSHBUTTON   "OK",IDOK,213,117,50,16
END

DLG_ABOUT DIALOGEX 0, 0, 186, 143
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Starfield"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,129,122,50,14,WS_GROUP
    CTEXT           "Starfield",IDC_STATIC,7,6,172,9
    CTEXT           "version 1.0",IDC_STATIC,7,17,172,8
    CTEXT           "Copyright (C) 2026 Dmitriy Belyaev",IDC_STATIC,7,27,172,8
    CTEXT           "Based on code by Terence M. Welsh (GNU GPL).",WEBPAGE,7,37,172,8,SS_NOTIFY | NOT WS_GROUP
    LTEXT           "  The iconic retro starfield screensaver. Bring back the nostalgia of traveling through deep space right from your screen.",IDC_STATIC,7,55,172,25
    LTEXT           "  This screensaver is free software licensed under the GNU General Public License v2. It utilizes OpenGL for rendering and requires hardware acceleration for optimal performance.",IDC_STATIC,7,85,172,34
END


