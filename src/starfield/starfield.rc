/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 186, 201
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Starfield   by Terry Welsh"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,7,180,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,68,180,50,14
    PUSHBUTTON      "About",ABOUT,129,180,50,14
    LTEXT           "Number of stars",IDC_STATIC,7,22,50,8
    LTEXT           "Speed",IDC_STATIC,7,52,22,8
    LTEXT           "Star size",IDC_STATIC,7,82,28,8
    CONTROL         "Slider1",NUMSTARS,"msctls_trackbar32",TBS_BOTH | 
                    TBS_NOTICKS | WS_TABSTOP,7,7,172,15
    CONTROL         "Slider1",SPEED,"msctls_trackbar32",TBS_BOTH | 
                    TBS_NOTICKS | WS_TABSTOP,7,37,172,15
    CONTROL         "Slider2",STARSIZE,"msctls_trackbar32",TBS_BOTH | 
                    TBS_NOTICKS | WS_TABSTOP,7,67,172,15
    PUSHBUTTON      "Defaults",DEFAULTS,103,158,50,14
    RTEXT           "#",NUMSTARSTEXT,63,22,20,8
    RTEXT           "#",SPEEDTEXT,63,52,20,8
    RTEXT           "#",STARSIZETEXT,63,82,20,8
    LTEXT           "Frame rate limit",IDC_STATIC,7,112,48,8
    CONTROL         "",FRAMERATELIMIT,"msctls_trackbar32",TBS_BOTH | 
                    TBS_NOTICKS | WS_TABSTOP,7,97,172,15
    RTEXT           "#",FRAMERATELIMITTEXT,58,112,25,8
    LTEXT           "0 = no limit",IDC_STATIC,103,112,34,8
END

DLG_ABOUT DIALOGEX 0, 0, 186, 143
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Starfield"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,129,122,50,14,WS_GROUP
    CTEXT           "Starfield",IDC_STATIC,7,6,172,9
    CTEXT           "version 1.0",IDC_STATIC,7,17,172,8
    CTEXT           "Copyright (C) 1999-2010 Terence M. Welsh",IDC_STATIC,7,
                    27,172,8
    CTEXT           "http://www.reallyslick.com",WEBPAGE,7,37,172,8,
                    SS_NOTIFY | NOT WS_GROUP
    LTEXT           "\tA classic starfield screensaver.  Stars fly toward the viewer creating a sense of travelling through space.  Enjoy.",
                    IDC_STATIC,7,55,172,25
    LTEXT           "   This screensaver is free software licensed under the terms of the Gnu General Public License version 2.  It uses OpenGL for graphics, and it will perform poorly without OpenGL hardware acceleration.",
                    IDC_STATIC,7,85,172,34
END


